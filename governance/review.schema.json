{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent review record",
  "type": "object",
  "additionalProperties": false,
  "required": ["reviewer", "authors", "verdict", "diff_sha256", "base_sha", "head_sha"],
  "properties": {
    "reviewer": {
      "allOf": [{"$ref": "#/$defs/identity"}],
      "required": ["model_family"],
      "properties": {"model_family": {"type": "string", "minLength": 1}}
    },
    "authors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identity"}},
    "verdict": {"enum": ["approve", "block"]},
    "diff_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of the diff excluding generated files in the generator manifest."},
    "base_sha": {"$ref": "#/$defs/sha"},
    "head_sha": {"$ref": "#/$defs/sha"},
    "signature": {"type": "object", "required": ["key_id", "algorithm", "value"], "additionalProperties": false, "properties": {"key_id": {"type": "string", "minLength": 1}, "algorithm": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1}}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "identity": {"type": "object", "required": ["model_id", "session_id"], "properties": {"model_id": {"type": "string", "minLength": 1}, "session_id": {"type": "string", "minLength": 1}, "model_family": {"type": "string", "minLength": 1}}, "additionalProperties": false}
  }
}
